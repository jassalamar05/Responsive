      "boundElements": null,
      "updated": 1770079342626,
      "link": null,
      "locked": false,
      "text": "🏆 13. INTERVIEW READY 5-LINES\n\nFrontend and backend are containerized separately\n\nBackend connects to MongoDB Atlas using env variables\n\nEC2 Security Groups handle port access\n\nDocker images are rebuilt after code changes\n\nFrontend never talks directly to database",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "🏆 13. INTERVIEW READY 5-LINES\n\nFrontend and backend are containerized separately\n\nBackend connects to MongoDB Atlas using env variables\n\nEC2 Security Groups handle port access\n\nDocker images are rebuilt after code changes\n\nFrontend never talks directly to database",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "sSzrIYJVTrJJjNl9Yt8Zt",
      "type": "rectangle",
      "x": 65.79225311598555,
      "y": 5620.456537632914,
      "width": 606.9358146275114,
      "height": 319.871663144233,
      "angle": 0,
      "strokeColor": "#f08c00",
